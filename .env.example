# EventHive Environment Configuration Template
# Copy this file to .env for local development.
# Never commit your actual .env file to GitHub.

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5000

# Admin Credentials (replace with your own values)
ADMIN_NAME="Your Admin Name"
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Authentication Security
JWT_SECRET=replace-with-a-long-random-secret

# College Configuration
COLLEGE_NAME="EventHive College of Engineering & Technology"
COLLEGE_EMAIL_DOMAIN=college.edu

# Monitoring (Docker Compose)
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-admin-password

# Database Configuration (Optional)
# Falls back to the built-in in-memory store if empty.
DATABASE_URL=

# AI Integration (Optional)
AI_API_KEY=

# Git and CI/CD Metadata
GITHUB_SHA=